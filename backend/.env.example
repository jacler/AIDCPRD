# Application
APP_NAME=AIDC-CostPro
APP_ENV=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://aidc:aidc_dev_password@localhost:5432/aidc_costpro

# Redis (optional, for future caching)
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# JWT & default admin (change in production)
JWT_SECRET_KEY=aidc-costpro-dev-secret-change-in-production
JWT_EXPIRE_MINUTES=1440
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_DISPLAY_NAME=系统管理员

# Consultation defaults (can also be changed in Settings page)
# CONSULTATION_PROVIDER=rule
# CONSULTATION_API_BASE_URL=https://api.openai.com/v1
# CONSULTATION_API_KEY=
# CONSULTATION_MODEL=gpt-4o-mini
